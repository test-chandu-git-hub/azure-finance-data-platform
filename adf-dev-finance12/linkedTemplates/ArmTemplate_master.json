{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dev-finance12"
		},
		"LS_ADLSGen2_Dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stdevfinance1.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Metadata_Dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finance-metadata-dev.database.windows.net"
		},
		"LS_AzureSQL_Metadata_Dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finance-metadata-dev"
		},
		"LS_AzureSQL_Metadata_Dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqlmetadataadmin"
		},
		"LS_KeyVault_Dev_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvdevfinance1.vault.azure.net/"
		},
		"LS_SFTP_Finance_Dev_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "stdevfinance1.blob.core.windows.net"
		},
		"LS_SFTP_Finance_Dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "stdevfinance1.sftpsalesuser"
		},
		"LS_SQLServer_Dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().pServerName}"
		},
		"LS_SQLServer_Dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().pDatabaseName}"
		},
		"LS_SQLServer_Dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_ingestion_user"
		},
		"SftpSalesTrigger_properties_PL-SFTP-BronzeIngestion_parameters_pSourceFolder": {
			"type": "string",
			"defaultValue": "sales/incoming"
		},
		"TRG_SFTP_FileArrival_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/9b165aad-26d0-4a47-93fd-f17ab3fd0817/resourceGroups/rg-dev-finance/providers/Microsoft.Storage/storageAccounts/stdevfinance1"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-dev-finance12_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSGen2_Dev_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_Dev_properties_typeProperties_url')]"
					},
					"LS_KeyVault_Dev_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_Dev_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSQL_Metadata_Dev_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Metadata_Dev_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Metadata_Dev_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Metadata_Dev_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Metadata_Dev_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Metadata_Dev_properties_typeProperties_userName')]"
					},
					"LS_SFTP_Finance_Dev_properties_typeProperties_host": {
						"value": "[parameters('LS_SFTP_Finance_Dev_properties_typeProperties_host')]"
					},
					"LS_SFTP_Finance_Dev_properties_typeProperties_userName": {
						"value": "[parameters('LS_SFTP_Finance_Dev_properties_typeProperties_userName')]"
					},
					"LS_SQLServer_Dev_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLServer_Dev_properties_typeProperties_server')]"
					},
					"LS_SQLServer_Dev_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLServer_Dev_properties_typeProperties_database')]"
					},
					"LS_SQLServer_Dev_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLServer_Dev_properties_typeProperties_userName')]"
					},
					"SftpSalesTrigger_properties_PL-SFTP-BronzeIngestion_parameters_pSourceFolder": {
						"value": "[parameters('SftpSalesTrigger_properties_PL-SFTP-BronzeIngestion_parameters_pSourceFolder')]"
					},
					"TRG_SFTP_FileArrival_properties_typeProperties_scope": {
						"value": "[parameters('TRG_SFTP_FileArrival_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}