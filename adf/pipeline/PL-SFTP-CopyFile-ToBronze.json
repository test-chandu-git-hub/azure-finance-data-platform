{
	"name": "PL-SFTP-CopyFile-ToBronze",
	"properties": {
		"description": "Reusable SFTP to ADLS Bronze copy with atomic SQL file claim and status tracking",
		"activities": [
			{
				"name": "LKP_Claim_SFTP_File",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC ctl.usp_ClaimSftpFile @SourceFolder=N''',replace(pipeline().parameters.pSourceFolder,'''',''''''),''', @FileName=N''',replace(pipeline().parameters.pFileName,'''',''''''),''', @PipelineRunId=N''',pipeline().RunId,'''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Metadata_SftpFileTracking",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "IF_Claim_Acquired",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LKP_Claim_SFTP_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(int(activity('LKP_Claim_SFTP_File').output.firstRow.Claimed),1)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "CP_SFTP_To_Bronze_copy",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "SftpReadSettings",
										"recursive": false,
										"deleteFilesAfterCompletion": false
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_SFTP_Source_Binary",
									"type": "DatasetReference",
									"parameters": {
										"pFolderPath": {
											"value": "@pipeline().parameters.pSourceFolder",
											"type": "Expression"
										},
										"pFileName": {
											"value": "@pipeline().parameters.pFileName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Bronze_Binary",
									"type": "DatasetReference",
									"parameters": {
										"pFolderPath": {
											"value": "@pipeline().parameters.pTargetFolder",
											"type": "Expression"
										},
										"pFileName": {
											"value": "@pipeline().parameters.pFileName",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SP_Mark_SFTP_Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CP_SFTP_To_Bronze_copy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctl].[usp_CompleteSftpFile]",
								"storedProcedureParameters": {
									"FileId": {
										"value": {
											"value": "@activity('LKP_Claim_SFTP_File').output.firstRow.FileId",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"Status": {
										"value": "SUCCESS",
										"type": "String"
									},
									"TargetPath": {
										"value": {
											"value": "@concat('bronze/',pipeline().parameters.pTargetFolder,'/',pipeline().parameters.pFileName)",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL_Metadata_Dev",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Mark_SFTP_Failed",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CP_SFTP_To_Bronze_copy",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctl].[usp_CompleteSftpFile]",
								"storedProcedureParameters": {
									"FileId": {
										"value": {
											"value": "@activity('LKP_Claim_SFTP_File').output.firstRow.FileId",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"PipelineRunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"Status": {
										"value": "FAILED",
										"type": "String"
									},
									"TargetPath": {
										"value": {
											"value": "@concat('bronze/',pipeline().parameters.pTargetFolder,'/',pipeline().parameters.pFileName)",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL_Metadata_Dev",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "FAIL_SFTP_Copy",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "SP_Mark_SFTP_Failed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Copy failed for file: ',pipeline().parameters.pFileName)",
									"type": "Expression"
								},
								"errorCode": "SFTP_COPY_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pSourceFolder": {
				"type": "String"
			},
			"pFileName": {
				"type": "String"
			},
			"pTargetFolder": {
				"type": "String"
			}
		},
		"annotations": []
	}
}