{
	"name": "PL-SFTP-BronzeIngestion",
	"properties": {
		"description": "Metadata-driven SFTP to ADLS Gen2 Bronze ingestion",
		"activities": [
			{
				"name": "GM_List_SFTP_Files",
				"description": "GM_List_SFTP_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_SFTP_Source_Binary",
						"type": "DatasetReference",
						"parameters": {
							"pFolderPath": {
								"value": "@pipeline().parameters.pSourceFolder",
								"type": "Expression"
							},
							"pFileName": "@string('')"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "FLT_CSV_Files",
				"description": "FLT_CSV_Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_List_SFTP_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_List_SFTP_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type,'File'),endsWith(toLower(item().name),'.csv'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FE_Process_SFTP_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FLT_CSV_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FLT_CSV_Files').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "EP_Invoke_SFTP_CopyToBronze",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL-SFTP-CopyFile-ToBronze",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"pSourceFolder": "@pipeline().parameters.pSourceFolder",
									"pFileName": "@item().name",
									"pTargetFolder": "@concat('sftp/',first(split(pipeline().parameters.pSourceFolder,'/')),'/ingestion_date=',formatDateTime(utcNow(),'yyyy-MM-dd'))"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pSourceFolder": {
				"type": "String",
				"defaultValue": "sales/incoming"
			}
		},
		"annotations": []
	}
}